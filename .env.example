# Unified Scholarship Mobile Application for Tribal Students (MoTA)
# Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Leave MONGO_URI blank or set to mongodb://localhost:27017/mota_scholarships to use MongoDB.
# If no local MongoDB is running, the server automatically starts an embedded in-memory MongoDB for zero-config evaluation)
MONGO_URI=mongodb://localhost:27017/mota_scholarships

# Redis Configuration (Used for BullMQ job queues in later phases)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets (Replace with 64+ char random strings in production)
JWT_ACCESS_SECRET=mota_access_jwt_secret_tribal_scholarship_key_2026_india
JWT_REFRESH_SECRET=mota_refresh_jwt_secret_tribal_scholarship_key_2026_india
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Field Level Encryption Key (32-byte hexadecimal string for AES-256-GCM encryption of sensitive bank tokens)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Integration & Mock Controls
USE_MOCKS=true
OTP_EXPIRY_MINUTES=10
DEFAULT_DEV_OTP=123456

# Logging
LOG_LEVEL=info
